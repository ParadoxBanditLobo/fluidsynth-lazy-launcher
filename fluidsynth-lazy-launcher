#!/usr/bin/env bash

# FluidSynth Lazy Launcher
# A small terminal menu for playing and rendering MIDI files with SoundFonts.

set -u

APP_NAME="FluidSynth Lazy Launcher"
VERSION="1.2.0-dev"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fluidsynth-lazy-launcher"
CONFIG_FILE="$CONFIG_DIR/config"
LOG_FILE="$CONFIG_DIR/fluidsynth.log"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MIDI_TOOL="$SCRIPT_DIR/midi-tools.py"
MIDI_SPEED="1.00"
PLAYBACK_MIDI=""

MIDI_DIR=""
SOUNDFONT_DIR=""
OUTPUT_DIR=""
SELECTED_MIDI=""
SELECTED_SOUNDFONT=""
SOUNDFONT_A=""
SOUNDFONT_B=""
SOUNDFONT_C=""
PLAYER_PID=""
CHOSEN_PATH=""
CHOSEN_FILE=""

pause() {
    printf '\nPress Enter to continue...'
    IFS= read -r _
}

clear_screen() {
    if command -v clear >/dev/null 2>&1 && [[ -t 1 ]]; then
        clear
    else
        printf '\n'
    fi
}

expand_path() {
    local path="$1"
    case "$path" in
        "~") printf '%s\n' "$HOME" ;;
        "~/"*) printf '%s/%s\n' "$HOME" "${path#~/}" ;;
        *) printf '%s\n' "$path" ;;
    esac
}

absolute_existing_dir() {
    local path
    path="$(expand_path "$1")"
    (cd "$path" 2>/dev/null && pwd -P)
}

absolute_output_dir() {
    local path
    path="$(expand_path "$1")"
    mkdir -p "$path" 2>/dev/null || return 1
    (cd "$path" 2>/dev/null && pwd -P)
}

load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0

    local key value
    while IFS='=' read -r key value; do
        case "$key" in
            MIDI_DIR) MIDI_DIR="$value" ;;
            SOUNDFONT_DIR) SOUNDFONT_DIR="$value" ;;
            OUTPUT_DIR) OUTPUT_DIR="$value" ;;
            SOUNDFONT_A) SOUNDFONT_A="$value" ;;
            SOUNDFONT_B) SOUNDFONT_B="$value" ;;
            SOUNDFONT_C) SOUNDFONT_C="$value" ;;
            MIDI_SPEED) MIDI_SPEED="$value" ;;
        esac
    done < "$CONFIG_FILE"
}

save_config() {
    mkdir -p "$CONFIG_DIR"
    {
        printf 'MIDI_DIR=%s\n' "$MIDI_DIR"
        printf 'SOUNDFONT_DIR=%s\n' "$SOUNDFONT_DIR"
        printf 'OUTPUT_DIR=%s\n' "$OUTPUT_DIR"
        printf 'SOUNDFONT_A=%s\n' "$SOUNDFONT_A"
        printf 'SOUNDFONT_B=%s\n' "$SOUNDFONT_B"
        printf 'SOUNDFONT_C=%s\n' "$SOUNDFONT_C"
        printf 'MIDI_SPEED=%s\n' "$MIDI_SPEED"
    } > "$CONFIG_FILE"
}

check_dependencies() {
    if ! command -v fluidsynth >/dev/null 2>&1; then
        printf '%s\n' "Error: FluidSynth is not installed or is not in PATH."
        printf '%s\n' "Install the 'fluidsynth' package, then run this launcher again."
        exit 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "Error: Python 3 is required for MIDI inspection and tempo control."
        exit 1
    fi
    if [[ ! -f "$MIDI_TOOL" ]]; then
        printf 'Error: MIDI helper not found: %s\n' "$MIDI_TOOL"
        exit 1
    fi
}

prompt_existing_dir() {
    local label="$1"
    local current="$2"
    local entered resolved

    while true; do
        printf '%s' "$label"
        [[ -n "$current" ]] && printf ' [%s]' "$current"
        printf ': '
        IFS= read -r entered
        [[ -z "$entered" ]] && entered="$current"

        if [[ -z "$entered" ]]; then
            printf 'A folder is required.\n'
            continue
        fi

        if resolved="$(absolute_existing_dir "$entered")"; then
            CHOSEN_PATH="$resolved"
            return 0
        fi

        printf 'Folder not found: %s\n' "$entered"
    done
}

prompt_output_dir() {
    local label="$1"
    local current="$2"
    local entered resolved

    while true; do
        printf '%s' "$label"
        [[ -n "$current" ]] && printf ' [%s]' "$current"
        printf ': '
        IFS= read -r entered
        [[ -z "$entered" ]] && entered="$current"

        if [[ -z "$entered" ]]; then
            printf 'A folder is required.\n'
            continue
        fi

        if resolved="$(absolute_output_dir "$entered")"; then
            CHOSEN_PATH="$resolved"
            return 0
        fi

        printf 'Could not create or access: %s\n' "$entered"
    done
}

configure_folders() {
    clear_screen
    printf '%s\n\n' "$APP_NAME - Folder Setup"

    prompt_existing_dir 'MIDI folder' "$MIDI_DIR"
    MIDI_DIR="$CHOSEN_PATH"
    prompt_existing_dir 'SoundFont folder' "$SOUNDFONT_DIR"
    SOUNDFONT_DIR="$CHOSEN_PATH"
    prompt_output_dir 'Output folder' "$OUTPUT_DIR"
    OUTPUT_DIR="$CHOSEN_PATH"

    save_config
}

folders_are_valid() {
    [[ -d "$MIDI_DIR" && -d "$SOUNDFONT_DIR" && -d "$OUTPUT_DIR" ]]
}

relative_name() {
    local full="$1"
    local root="$2"
    printf '%s\n' "${full#"$root"/}"
}

choose_file() {
    local kind="$1"
    local root="$2"
    shift 2
    local -a extensions=("$@")
    local filter choice i file ext lower_file lower_filter
    local -a all_files=()
    local -a shown_files=()

    while IFS= read -r -d '' file; do
        all_files+=("$file")
    done < <(find "$root" -type f -print0 2>/dev/null)

    for file in "${all_files[@]}"; do
        lower_file="${file,,}"
        for ext in "${extensions[@]}"; do
            if [[ "$lower_file" == *".${ext,,}" ]]; then
                shown_files+=("$file")
                break
            fi
        done
    done

    if ((${#shown_files[@]} == 0)); then
        printf 'No %s files found in:\n%s\n' "$kind" "$root"
        pause
        return 1
    fi

    printf 'Filter by name (blank shows all): '
    IFS= read -r filter

    if [[ -n "$filter" ]]; then
        lower_filter="${filter,,}"
        all_files=("${shown_files[@]}")
        shown_files=()
        for file in "${all_files[@]}"; do
            if [[ "${file,,}" == *"$lower_filter"* ]]; then
                shown_files+=("$file")
            fi
        done
    fi

    if ((${#shown_files[@]} == 0)); then
        printf 'No matching %s files.\n' "$kind"
        pause
        return 1
    fi

    printf '\n'
    for ((i = 0; i < ${#shown_files[@]}; i++)); do
        printf '%3d. %s\n' "$((i + 1))" "$(relative_name "${shown_files[$i]}" "$root")"
    done
    printf '  0. Cancel\n\n'

    while true; do
        printf 'Choose %s: ' "$kind"
        IFS= read -r choice

        if [[ "$choice" == "0" ]]; then
            return 1
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#shown_files[@]})); then
            CHOSEN_FILE="${shown_files[$((choice - 1))]}"
            return 0
        fi

        printf 'Invalid selection.\n'
    done
}

select_midi() {
    clear_screen
    printf 'Select MIDI\n\n'
    if choose_file 'MIDI' "$MIDI_DIR" mid midi; then
        SELECTED_MIDI="$CHOSEN_FILE"
    fi
}

select_soundfont() {
    clear_screen
    printf 'Select SoundFont\n\n'
    if choose_file 'SoundFont' "$SOUNDFONT_DIR" sf2 sf3; then
        SELECTED_SOUNDFONT="$CHOSEN_FILE"
    fi
}


soundfont_slot_value() {
    case "$1" in A) printf '%s\n' "$SOUNDFONT_A" ;; B) printf '%s\n' "$SOUNDFONT_B" ;; C) printf '%s\n' "$SOUNDFONT_C" ;; esac
}
set_soundfont_slot() {
    case "$1" in A) SOUNDFONT_A="$2" ;; B) SOUNDFONT_B="$2" ;; C) SOUNDFONT_C="$2" ;; esac
    save_config
}
choose_soundfont_for_slot() {
    local slot="$1"
    if choose_file 'SoundFont' "$SOUNDFONT_DIR" sf2 sf3; then
        set_soundfont_slot "$slot" "$CHOSEN_FILE"
        SELECTED_SOUNDFONT="$CHOSEN_FILE"
        printf 'Loaded slot %s: %s\n' "$slot" "$(basename "$CHOSEN_FILE")"
    fi
}
list_soundfont_presets() {
    local sf="$1" sfid
    [[ -f "$sf" ]] || return 1

    sfid="$(
        { printf 'fonts\n'; printf 'quit\n'; } |
            fluidsynth -n "$sf" 2>/dev/null |
            sed -nE 's/^[[:space:]]*([0-9]+)[[:space:]]+.+$/\1/p' |
            head -n 1
    )"
    [[ -n "$sfid" ]] || sfid=1

    { printf 'inst %s\n' "$sfid"; printf 'quit\n'; } |
        fluidsynth -n "$sf" 2>/dev/null |
        sed -nE 's/^[[:space:]]*([0-9]{1,3})-([0-9]{1,3})[[:space:]]+(.+)$/\1 \2 \3/p'
}
preview_soundfont_preset() {
    local sf="$1" bank="$2" program="$3" sfid
    sfid="$(
        { printf 'fonts\n'; printf 'quit\n'; } |
            fluidsynth -n "$sf" 2>/dev/null |
            sed -nE 's/^[[:space:]]*([0-9]+)[[:space:]]+.+$/\\1/p' |
            head -n 1
    )"
    [[ -n "$sfid" ]] || sfid=1

    printf 'Previewing bank %d, program %d...\n' "$bank" "$program"
    { printf 'select 0 %d %d %d\n' "$sfid" "$bank" "$program"; printf 'noteon 0 60 96\n'; sleep 0.25;
      printf 'noteon 0 64 90\n'; sleep 0.25; printf 'noteon 0 67 90\n'; sleep 0.65;
      printf 'noteoff 0 60\nnoteoff 0 64\nnoteoff 0 67\nquit\n'; } |
        fluidsynth -n "$sf" >/dev/null 2>&1
}
browse_soundfont_slot() {
    local slot="$1" sf presets choice bank program name count
    sf="$(soundfont_slot_value "$slot")"
    [[ -n "$sf" && -f "$sf" ]] || { printf 'Slot %s is empty.\n' "$slot"; pause; return; }
    presets="$(list_soundfont_presets "$sf")"
    [[ -n "$presets" ]] || { printf 'No presets could be read.\n'; pause; return; }
    while true; do
        clear_screen
        printf 'SoundFont %s: %s\n\n' "$slot" "$(basename "$sf")"
        printf ' #   BANK PROG  PRESET\n%s\n' '------------------------------'
        count=0
        while read -r bank program name; do
            ((count++)); printf '%3d  %3d  %3d  %s\n' "$count" "$((10#$bank))" "$((10#$program))" "$name"
        done <<< "$presets"
        printf '\nPreset number to preview (0 returns): '; IFS= read -r choice
        [[ "$choice" == 0 ]] && return
        if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)); then
            read -r bank program name <<< "$(sed -n "${choice}p" <<< "$presets")"
            preview_soundfont_preset "$sf" "$((10#$bank))" "$((10#$program))"
        else printf 'Invalid selection.\n'; pause; fi
    done
}
soundfont_workspace() {
    local choice slot current
    while true; do
        clear_screen
        printf 'SoundFont Workspace\n===================\n\n'
        printf 'A: %s\nB: %s\nC: %s\n\n' "${SOUNDFONT_A:-Empty}" "${SOUNDFONT_B:-Empty}" "${SOUNDFONT_C:-Empty}"
        printf '1. Load/replace slot A\n2. Load/replace slot B\n3. Load/replace slot C\n'
        printf '4. Browse/preview slot A\n5. Browse/preview slot B\n6. Browse/preview slot C\n'
        printf '7. Unload a slot\n8. Back\n\nChoose an option: '; IFS= read -r choice
        case "$choice" in
            1|2|3) case "$choice" in 1) slot=A ;; 2) slot=B ;; 3) slot=C ;; esac; choose_soundfont_for_slot "$slot"; pause ;;
            4) browse_soundfont_slot A ;; 5) browse_soundfont_slot B ;; 6) browse_soundfont_slot C ;;
            7) printf 'Unload slot (A/B/C): '; IFS= read -r slot; slot="${slot^^}"
               if [[ "$slot" == A || "$slot" == B || "$slot" == C ]]; then
                   current="$(soundfont_slot_value "$slot")"; set_soundfont_slot "$slot" ""
                   [[ "$SELECTED_SOUNDFONT" == "$current" ]] && SELECTED_SOUNDFONT=""
                   printf 'Slot %s unloaded.\n' "$slot"
               else printf 'Invalid slot.\n'; fi; pause ;;
            8) return ;; *) printf 'Invalid option.\n'; pause ;;
        esac
    done
}


require_midi() {
    if [[ -z "$SELECTED_MIDI" || ! -f "$SELECTED_MIDI" ]]; then
        printf 'Choose a MIDI file first.\n'
        return 1
    fi
}

inspect_selected_midi() {
    require_midi || { pause; return; }
    clear_screen
    printf 'MIDI Inspector\n==============\n\n'
    printf 'File: %s\n\n' "$SELECTED_MIDI"
    python3 "$MIDI_TOOL" inspect "$SELECTED_MIDI"
    pause
}

set_midi_speed() {
    local choice entered
    clear_screen
    printf 'MIDI Playback Speed\n===================\n\n'
    printf 'Current speed: %sx\n\n' "$MIDI_SPEED"
    printf '1. 0.50x\n2. 0.75x\n3. 1.00x\n4. 1.25x\n5. 1.50x\n6. 2.00x\n7. Custom\n8. Cancel\n\n'
    printf 'Choose an option: '
    IFS= read -r choice
    case "$choice" in
        1) MIDI_SPEED="0.50" ;;
        2) MIDI_SPEED="0.75" ;;
        3) MIDI_SPEED="1.00" ;;
        4) MIDI_SPEED="1.25" ;;
        5) MIDI_SPEED="1.50" ;;
        6) MIDI_SPEED="2.00" ;;
        7)
            printf 'Enter multiplier (0.05 to 8.0): '
            IFS= read -r entered
            if python3 - "$entered" <<'PY'
import sys
try:
    v=float(sys.argv[1])
    raise SystemExit(0 if 0.05 <= v <= 8.0 else 1)
except Exception:
    raise SystemExit(1)
PY
            then
                MIDI_SPEED="$entered"
            else
                printf 'Invalid speed.\n'
                pause
                return
            fi
            ;;
        8) return ;;
        *) printf 'Invalid option.\n'; pause; return ;;
    esac
    save_config
    printf 'Playback speed set to %sx.\n' "$MIDI_SPEED"
    pause
}

prepare_speed_midi() {
    local source="$1" target="$2"
    if [[ "$MIDI_SPEED" == "1" || "$MIDI_SPEED" == "1.0" || "$MIDI_SPEED" == "1.00" ]]; then
        printf '%s\n' "$source"
        return 0
    fi
    mkdir -p "$CONFIG_DIR"
    rm -f "$target"
    if python3 "$MIDI_TOOL" speed "$source" "$target" "$MIDI_SPEED" >/dev/null; then
        printf '%s\n' "$target"
        return 0
    fi
    rm -f "$target"
    return 1
}

player_is_running() {
    local _pid _comm state _rest

    [[ -n "$PLAYER_PID" ]] || return 1
    if ! kill -0 "$PLAYER_PID" 2>/dev/null; then
        wait "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
        return 1
    fi

    # A completed background process can remain briefly as a zombie until reaped.
    if [[ -r "/proc/$PLAYER_PID/stat" ]]; then
        read -r _pid _comm state _rest < "/proc/$PLAYER_PID/stat" || true
        if [[ "$state" == "Z" ]]; then
            wait "$PLAYER_PID" 2>/dev/null || true
            PLAYER_PID=""
            return 1
        fi
    fi

    return 0
}

stop_playback() {
    if player_is_running; then
        kill "$PLAYER_PID" 2>/dev/null || true
        wait "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
        printf 'Playback stopped.\n'
    else
        PLAYER_PID=""
        printf 'Nothing is currently playing.\n'
    fi
}

require_selection() {
    if [[ -z "$SELECTED_MIDI" || ! -f "$SELECTED_MIDI" ]]; then
        printf 'Choose a MIDI file first.\n'
        return 1
    fi
    if [[ -z "$SELECTED_SOUNDFONT" || ! -f "$SELECTED_SOUNDFONT" ]]; then
        printf 'Choose a SoundFont first.\n'
        return 1
    fi
}

play_selected() {
    require_selection || { pause; return; }

    if player_is_running; then
        kill "$PLAYER_PID" 2>/dev/null || true
        wait "$PLAYER_PID" 2>/dev/null || true
    fi

    mkdir -p "$CONFIG_DIR"
    : > "$LOG_FILE"

    if ! PLAYBACK_MIDI="$(prepare_speed_midi "$SELECTED_MIDI" "$CONFIG_DIR/playback-speed.mid")"; then
        printf 'Could not prepare MIDI at %sx speed.\n' "$MIDI_SPEED"
        pause
        return
    fi

    fluidsynth -ni "$SELECTED_SOUNDFONT" "$PLAYBACK_MIDI" >"$LOG_FILE" 2>&1 &
    PLAYER_PID=$!

    sleep 0.2
    if player_is_running; then
        printf 'Playing: %s\n' "$(basename "$SELECTED_MIDI")"
        printf 'SoundFont: %s\n' "$(basename "$SELECTED_SOUNDFONT")"
        printf 'Speed: %sx\n' "$MIDI_SPEED"
    else
        wait "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
        printf 'FluidSynth could not start playback.\n'
        printf 'Log: %s\n' "$LOG_FILE"
    fi
    pause
}

safe_stem() {
    local name="$1"
    name="${name%.*}"
    name="${name//\//_}"
    printf '%s\n' "$name"
}

unique_output_path() {
    local base="$1"
    local extension="$2"
    local candidate="$OUTPUT_DIR/$base.$extension"
    local counter=2

    while [[ -e "$candidate" ]]; do
        candidate="$OUTPUT_DIR/$base ($counter).$extension"
        ((counter++))
    done

    printf '%s\n' "$candidate"
}

render_selected() {
    local midi_stem sf_stem output status render_midi
    require_selection || { pause; return; }

    midi_stem="$(safe_stem "$(basename "$SELECTED_MIDI")")"
    sf_stem="$(safe_stem "$(basename "$SELECTED_SOUNDFONT")")"
    output="$(unique_output_path "$midi_stem - $sf_stem" wav)"

    render_midi="$(prepare_speed_midi "$SELECTED_MIDI" "$CONFIG_DIR/render-speed.mid")" || {
        printf 'Could not prepare MIDI at %sx speed.\n' "$MIDI_SPEED"
        pause
        return
    }

    clear_screen
    printf 'Rendering:\n  MIDI: %s\n  SoundFont: %s\n  Speed: %sx\n  Output: %s\n\n' \
        "$SELECTED_MIDI" "$SELECTED_SOUNDFONT" "$MIDI_SPEED" "$output"

    fluidsynth -ni -T wav -F "$output" "$SELECTED_SOUNDFONT" "$render_midi"
    status=$?

    if ((status == 0)) && [[ -s "$output" ]]; then
        printf '\nFinished: %s\n' "$output"
    else
        rm -f "$output"
        printf '\nRender failed with exit code %d.\n' "$status"
    fi
    pause
}

render_selected_mp3() {
    local midi_stem sf_stem output temp_dir temp_wav render_status encode_status render_midi
    require_selection || { pause; return; }

    if ! command -v ffmpeg >/dev/null 2>&1; then
        printf 'MP3 export requires FFmpeg. Install the ffmpeg package first.\n'
        pause
        return
    fi

    midi_stem="$(safe_stem "$(basename "$SELECTED_MIDI")")"
    sf_stem="$(safe_stem "$(basename "$SELECTED_SOUNDFONT")")"
    output="$(unique_output_path "$midi_stem - $sf_stem" mp3)"
    temp_dir="$(mktemp -d "$OUTPUT_DIR/.fluidsynth-render-XXXXXX")" || {
        printf 'Could not create a temporary render folder.\n'
        pause
        return
    }
    temp_wav="$temp_dir/render.wav"

    render_midi="$(prepare_speed_midi "$SELECTED_MIDI" "$CONFIG_DIR/render-speed.mid")" || {
        rm -rf "$temp_dir"
        printf 'Could not prepare MIDI at %sx speed.\n' "$MIDI_SPEED"
        pause
        return
    }

    clear_screen
    printf 'Rendering MP3:\n  MIDI: %s\n  SoundFont: %s\n  Speed: %sx\n  Output: %s\n\n' \
        "$SELECTED_MIDI" "$SELECTED_SOUNDFONT" "$MIDI_SPEED" "$output"

    fluidsynth -ni -T wav -F "$temp_wav" "$SELECTED_SOUNDFONT" "$render_midi"
    render_status=$?

    if ((render_status != 0)) || [[ ! -s "$temp_wav" ]]; then
        rm -rf "$temp_dir"
        rm -f "$output"
        printf '\nFluidSynth render failed with exit code %d.\n' "$render_status"
        pause
        return
    fi

    ffmpeg -hide_banner -loglevel error -y -i "$temp_wav" -codec:a libmp3lame -q:a 2 "$output"
    encode_status=$?
    rm -rf "$temp_dir"

    if ((encode_status == 0)) && [[ -s "$output" ]]; then
        printf '\nFinished: %s\n' "$output"
    else
        rm -f "$output"
        printf '\nMP3 conversion failed with exit code %d.\n' "$encode_status"
    fi
    pause
}

choose_random_midi() {
    local -a files=()
    local file lower

    while IFS= read -r -d '' file; do
        lower="${file,,}"
        if [[ "$lower" == *.mid || "$lower" == *.midi ]]; then
            files+=("$file")
        fi
    done < <(find "$MIDI_DIR" -type f -print0 2>/dev/null)

    if ((${#files[@]} == 0)); then
        printf 'No MIDI files found.\n'
        pause
        return
    fi

    SELECTED_MIDI="${files[RANDOM % ${#files[@]}]}"
    printf 'Random MIDI selected: %s\n' "$(relative_name "$SELECTED_MIDI" "$MIDI_DIR")"
    pause
}

show_status() {
    local playback="Stopped"
    player_is_running && playback="Playing"

    printf 'MIDI folder:      %s\n' "$MIDI_DIR"
    printf 'SoundFont folder: %s\n' "$SOUNDFONT_DIR"
    printf 'Output folder:    %s\n' "$OUTPUT_DIR"
    printf '\nSelected MIDI:      %s\n' "${SELECTED_MIDI:-None}"
    printf 'Selected SoundFont: %s\n' "${SELECTED_SOUNDFONT:-None}"
    printf 'SoundFont slots:   A=%s | B=%s | C=%s\n' "${SOUNDFONT_A:+Loaded}" "${SOUNDFONT_B:+Loaded}" "${SOUNDFONT_C:+Loaded}"
    printf 'Playback speed:     %sx\n' "$MIDI_SPEED"
    printf 'Playback:           %s\n' "$playback"
}

cleanup() {
    if player_is_running; then
        kill "$PLAYER_PID" 2>/dev/null || true
        wait "$PLAYER_PID" 2>/dev/null || true
    fi
}

main_menu() {
    local choice

    while true; do
        clear_screen
        printf '%s v%s\n' "$APP_NAME" "$VERSION"
        printf '%s\n\n' "=========================="
        show_status
        printf '\n'
        printf '1. Choose MIDI\n'
        printf '2. Choose SoundFont\n'
        printf '3. Play selected MIDI\n'
        printf '4. Stop playback\n'
        printf '5. Render selected MIDI to WAV\n'
        printf '6. Render selected MIDI to MP3\n'
        printf '7. Choose a random MIDI\n'
        printf '8. Change folders\n'
        printf '9. SoundFont workspace\n'
        printf '10. Inspect selected MIDI\n'
        printf '11. Change MIDI speed\n'
        printf '12. Exit\n\n'
        printf 'Choose an option: '
        IFS= read -r choice

        case "$choice" in
            1) select_midi ;;
            2) select_soundfont ;;
            3) play_selected ;;
            4) stop_playback; pause ;;
            5) render_selected ;;
            6) render_selected_mp3 ;;
            7) choose_random_midi ;;
            8) configure_folders ;;
            9) soundfont_workspace ;;
            10) inspect_selected_midi ;;
            11) set_midi_speed ;;
            12) break ;;
            *) printf 'Invalid option.\n'; pause ;;
        esac
    done
}

main() {
    if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
        printf "%s v%s\n" "$APP_NAME" "$VERSION"
        return 0
    fi

    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    check_dependencies
    load_config

    if ! folders_are_valid; then
        configure_folders
    fi

    main_menu
}

main "$@"
